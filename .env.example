# ============================================================
# Lampang Bus System — Root Environment Variables
# ============================================================
# Used by: docker-compose.yml (MySQL + Adminer)
# Copy to: .env (same directory as docker-compose.yml)
#
# NOTE: The backend has its OWN .env at backend/.env
#       See backend/.env.example for backend-specific variables.
# ============================================================

# ── Database ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lampang_bus
DB_USER=lampang
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

# ── JWT ─────────────────────────────────────
# Must be at least 32 characters.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── LINE OA (leave blank for dry-run) ──────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=

# ── App ─────────────────────────────────────
PORT=3000
NODE_ENV=development
TZ=Asia/Bangkok
CURRENT_TERM=2568-2

# ── Export ──────────────────────────────────
PDF_FONT_PATH=./fonts/THSarabunNew.ttf
