# ============================================
# Lampang Bus System — Backend Environment
# ============================================
# Copy this file to .env and fill in actual values.
# Lines marked [REQUIRED] must be set before the app will start.
# Lines marked [OPTIONAL] have sensible defaults.
#
# NOTE: docker-compose.yml reads from the ROOT .env file
#       (one level up). See ../.env.example for that file.
#       This file is for the Node.js backend only.

# ── Database [REQUIRED] ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lampang_bus
DB_USER=root
DB_PASSWORD=CHANGE_ME

# ── JWT [REQUIRED] ──────────────────────────
# Secret must be at least 32 characters. App will refuse to start otherwise.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── LINE OA [OPTIONAL in dev / REQUIRED in production] ──
# Leave blank to run in dry-run mode (no LINE messages sent).
# LINE_CHANNEL_SECRET is REQUIRED when NODE_ENV=production: the app refuses to
# start without it so webhook signature verification cannot fail open.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
# Target LINE Group ID for emergency push notifications.
# Capture from webhook source.groupId after inviting the bot to the school group.
LINE_GROUP_ID=

# ── Cron/Internal API [OPTIONAL in dev / REQUIRED in production] ──
# API key for POST /api/line/process-notifications.
# Requests must include header: x-api-key: <this value>
# REQUIRED when NODE_ENV=production: the app refuses to start without it, and
# the endpoint fails closed (503) rather than running unauthenticated.
CRON_API_KEY=

# ── App [OPTIONAL] ──────────────────────────
PORT=3000
NODE_ENV=development
TZ=Asia/Bangkok
CURRENT_TERM=2568-2
DRIVER_SESSION_SWITCH_HOUR=12
SAFETY_POLICY_MODE=observe
# SAFETY_ENFORCEMENT_AT is ADVISORY metadata ONLY (record-keeping). Setting an
# ISO-8601 date here does NOT auto-switch the system to ENFORCE when that time
# arrives — there is no time-based auto-flip. To actually enforce, you must
# MANUALLY set SAFETY_POLICY_MODE=enforce. Use this field only to document a
# planned cutover date; it changes no runtime behaviour on its own.
SAFETY_ENFORCEMENT_AT=
# Comma-separated browser origins allowed to read the API cross-origin in
# production. Defaults to the known site domains. Non-production allows any
# origin. The SPA is same-origin with the API, so this only affects external
# cross-origin callers.
CORS_ORIGINS=https://schoolbuslampang.com,https://www.schoolbuslampang.com,https://schoolbus.lp-pao.go.th

# ── Export [OPTIONAL] ───────────────────────
# Path to Thai font for PDF export. Falls back to Helvetica if missing.
PDF_FONT_PATH=./fonts/THSarabunNew.ttf

# ── Operations alerting [OPTIONAL — Phase 10.13B-9] ───────────────────────
# integrity-monitor.js reports "alert disabled" if these are unset (it never
# fails for missing alert config). Delivery is not implemented in this phase —
# these keys reserve the contract so alerting can be enabled without a rewrite.
ALERT_LINE_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=
ALERT_SMTP_USER=
ALERT_SMTP_PASS=

# ── Participatory administration cases [OPTIONAL — Phase 4] ──────────────
# Case + append-only event log that proves a voice was raised, considered,
# acted on and reported back. Dark by default: when false the
# /api/participation router is not mounted. Apply migration 050 first;
# migrations/rollback/050_participation_cases_rollback.sql reverses it while
# the tables are still empty.
FEATURE_PARTICIPATION_CASES=false

# ── Account recovery via LINE [OPTIONAL] ─────────────────────────────────
# Keep false until migration 049 is applied and the account holder has
# completed a live LIFF + LINE OA delivery test.
FEATURE_ADMIN_PASSWORD_RECOVERY=false
PUBLIC_APP_URL=https://schoolbuslampang.com

# Per-role flags for the remaining login roles. Setting one is NOT enough to
# open a role: `backend/src/config/accountRecoveryPolicy.js` also requires that
# role's decision gates to be recorded as confirmed, which needs a code change
# reviewed alongside the signed decision. See
# docs/project-closure/decision-package-account-recovery-roles-2026-09-04.md.
# Every role below is currently blocked on `decision_gates_unconfirmed`.
# FEATURE_RECOVERY_PROVINCE=false
# FEATURE_RECOVERY_AFFILIATION=false
# FEATURE_RECOVERY_TRANSPORT=false
# FEATURE_RECOVERY_SCHOOL=false
# FEATURE_RECOVERY_DRIVER=false

# ── Restore-test readiness [OPTIONAL — Phase 10.13B-9] ────────────────────
# Used by scripts/restore-test-readiness.sh (place in scripts/restore-test.env,
# chmod 600). Never point RESTORE_TEST_DB at the production DB.
# RESTORE_TEST_DB=lampang_bus_restoretest
# RESTORE_TEST_MYSQL_DEFAULTS_FILE=/home/schoolbus/.restore-test.cnf
# RESTORE_TEST_ALLOW_CREATE_DATABASE=false

# ── Vehicle QR feature [OPTIONAL — Phase QR-1] ────────────────────────────
# Dark by default. When false, /api/qr + /api/consent are not mounted.
FEATURE_VEHICLE_QR=false
# Level-3 sensitive driver-history viewer (DPO sign-off required before enabling).
# Requires FEATURE_VEHICLE_QR=true. The backend refuses to start if level 3 is
# enabled while the base vehicle QR feature is disabled.
FEATURE_QR_LEVEL3=false
# Source for the parent-level emergency contact: driver | attendant | school
QR_EMERGENCY_CONTACT_SOURCE=driver

# ── Multi-vehicle driver shift selection [OPTIONAL] ─────────────────────
# Keep false until migration 039 is applied, driver accounts have driver_id,
# qualifications/assignments are loaded, and drivers have been briefed.
# When true, check-in, location, and emergency operations require an open shift.
FEATURE_DRIVER_SHIFT_SELECTION=false

# ── Driver vehicle-registration roster (Phase 10.14) [OPTIONAL] ─────────
# Keep false until migration 044 is applied. When true, mounts the
# /api/{driver,school}/registrations routers (drivers add riders + pick a
# school; each school reconciles + approves). When false these paths 404 and
# the existing system is byte-for-byte unchanged.
# NOTE: a vehicle's registration eligibility only BLOCKS a driver's pre-trip
# when BOTH this flag is true AND SAFETY_POLICY_MODE=enforce. With the flag on
# but SAFETY_POLICY_MODE=observe, eligibility is informational only (no block).
# Roll out per-school (canary) after briefing.
FEATURE_DRIVER_REGISTRATION=false
