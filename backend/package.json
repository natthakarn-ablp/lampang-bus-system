{
  "name": "lampang-bus-backend",
  "version": "2.0.0",
  "description": "Lampang Bus System — Backend API",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "//test-workflow": "TEST ISOLATION: the suite targets the DISPOSABLE database lampang_bus_test, never the dev clone lampang_bus_dev. Env comes from backend/.env.test (gitignored), loaded by tests/loadTestEnv.js via jest `setupFiles` and required in tests/setup.js + tests/teardown.js + scripts/prepare-test-db.js. Local workflow: `npm run test:prepare` once to (re)build lampang_bus_test, then `npm test`. `npm run test:ci` does both in one shot. `npm run test:unit` is DB-free and needs no database.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --testEnvironment=node --runInBand --forceExit",
    "test:unit": "jest --config jest.unit.config.js --runInBand --forceExit",
    "test:prepare": "node scripts/prepare-test-db.js",
    "test:ci": "npm run test:prepare && jest --testEnvironment=node --runInBand --forceExit",
    "check:migrations": "node scripts/validate-migration-baseline.js",
    "migrate": "node scripts/migrate-from-excel.js",
    "create:admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@line/bot-sdk": "^10.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "pdfkit": "^0.15.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "./tests/loadTestEnv.js"
    ],
    "globalSetup": "./tests/setup.js",
    "globalTeardown": "./tests/teardown.js"
  }
}
