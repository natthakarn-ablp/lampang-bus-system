{
  "name": "lampang-bus-frontend",
  "version": "2.0.0",
  "description": "Lampang Bus System — Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "qa:browser": "sh -c 'cp ../scripts/browser-review.mjs ./browser-review.mjs && node ./browser-review.mjs; code=$?; rm -f ./browser-review.mjs; exit $code'",
    "check:labels": "node ../scripts/check-ui-labels.js",
    "check:labels:strict": "node ../scripts/check-ui-labels.js --strict",
    "check:labels:verbose": "node ../scripts/check-ui-labels.js --verbose",
    "check:hybrid-ui": "node ./scripts/check-hybrid-motion-ui.mjs",
    "hooks:install": "node ../scripts/install-hooks.js",
    "hooks:install:strict": "node ../scripts/install-hooks.js --strict",
    "hooks:remove": "node ../scripts/install-hooks.js --remove"
  },
  "dependencies": {
    "@line/liff": "^2.28.0",
    "axios": "^1.7.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "motion": "^12.41.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.3"
  }
}
